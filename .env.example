# Sao chép thành .env và điền giá trị thật. Không commit .env.
# Tuyệt đối không đặt mật khẩu Yahoo, cookie hay OTP vào bất kỳ biến nào ở đây.

# --- Database ---
DATABASE_URL=postgresql+psycopg://yahoo_app:CHANGE_ME@127.0.0.1:5432/yahoo_vps

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Bí mật ký/băm token thiết bị (chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -hex 32)
DEVICE_TOKEN_PEPPER=CHANGE_ME

# --- Dashboard pairing ---
PAIRING_CODE_TTL_SECONDS=300
PAIRING_MAX_ATTEMPTS=5
DASHBOARD_SESSION_SECRET=CHANGE_ME

# --- Yahoo adapter ---
# Cổng an toàn theo mặc định: không bật hành động thật cho tới khi adapter đã
# qua Cổng B (đọc + dry-run) với tài khoản và loại listing cụ thể.
LIVE_ACTIONS_ENABLED=false
YAHOO_ADAPTER=mock
# unknown_cost_policy mặc định toàn hệ thống; từng lệnh có thể siết chặt hơn,
# không được nới lỏng hơn giá trị này khi LIVE_ACTIONS_ENABLED=true.
DEFAULT_UNKNOWN_COST_POLICY=BLOCK

# --- Playwright / Yahoo VPS session (chỉ dùng khi YAHOO_ADAPTER=yahoo) ---
YAHOO_PLAYWRIGHT_PROFILE_DIR=/var/lib/yahoo-vps/playwright-profile
YAHOO_ADAPTER_HEADLESS=true
YAHOO_ALLOWED_NAV_DOMAINS=auctions.yahoo.co.jp,login.yahoo.co.jp,payment.yahoo.co.jp

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10

# --- Logging ---
LOG_LEVEL=INFO
